rules_version = '2';

// Cada persona solo puede leer y escribir dentro de users/{su propio id}.
// Todo lo demás está cerrado.
service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{uid}/config/habits {
      allow read: if isOwner(uid);
      allow write: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['items'])
        && request.resource.data.items is list
        && request.resource.data.items.size() <= 200;
    }

    match /users/{uid}/logs/{month} {
      allow read: if isOwner(uid);
      allow write: if isOwner(uid)
        && month.matches('^[0-9]{4}-[0-9]{2}$')
        && (request.method == 'delete'
            || (request.resource.data.keys().hasOnly(['days']) && request.resource.data.days is map));
    }

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }
  }
}
